  "type": "module",
  "bin": { "shipskit": "bin/shipskit.mjs" },
  "files": ["bin", "lib", "src", "public", "skill", "action.yml", "remotion.config.ts", "tsconfig.json"],
  "engines": { "node": "^20.19.0 || ^22.13.0 || >=24" },
