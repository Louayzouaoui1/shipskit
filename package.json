    "@remotion/three": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
